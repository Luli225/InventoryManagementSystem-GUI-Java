<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>
	<connectionStrings>
		<add name="DefaultConnection"
             connectionString="Server=LULI;Database=DailyExpenseTrackerDB;Integrated Security=True;"
             providerName="System.Data.SqlClient" />
		<!--
        OR for Windows Authentication (if your SQL Server is configured for it and your Windows user has access):
        <add name="DefaultConnection"
             connectionString="Server=YOUR_SERVER_NAME;Database=DailyExpenseTrackerDB;Integrated Security=True;"
             providerName="System.Data.SqlClient" />
        -->
	</connectionStrings>
</configuration>